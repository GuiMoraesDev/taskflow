# Copy to .claude/workflow.env - machine-specific and never committed
# (.claude/.gitignore lists it). Leave it out to keep plans in the repo.

# Where plans live: "repo" (projectsDir in workflow.json) or "obsidian".
TASKFLOW_PLANS_SOURCE=obsidian

# The vault, by folder name (matched against your Obsidian vault list)...
TASKFLOW_OBSIDIAN_VAULT=MyVault
# ...or by absolute path, which wins over the name.
# TASKFLOW_OBSIDIAN_VAULT_PATH=/Users/you/Documents/MyVault

# The folder inside the vault: no "..", no leading "/".
TASKFLOW_OBSIDIAN_PATH=taskflow/my-repo
